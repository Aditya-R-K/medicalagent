# Source documents never enter version control — they may be licensed or
# contain patient-identifiable material.
knowledgebase/*
!knowledgebase/README.md

# Indexes are derived artefacts; rebuild with `python main.py ingest`.
.index/
.index-smoke/

# Audit logs contain clinician queries, which contain patient context.
# Treat as clinical records: access-controlled, never committed.
.audit/

# Your own evaluation questions may quote patient cases.
eval/questions.yaml

__pycache__/
*.py[cod]
.venv/
venv/
.env

# Logs
.logs/
