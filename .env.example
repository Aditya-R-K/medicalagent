# AI Doctor - settings for docker compose. Not tracked by git.

# ---------------------------------------------------------------------------
# API key - required
# ---------------------------------------------------------------------------
# Search always uses OpenAI's text-embedding-3-large, so a key is needed even
# when answers are written by a local model.
OPENAI_API_KEY=sk-your-key-here

# ---------------------------------------------------------------------------
# Model that writes the answers:  openai, nvidia  or  ollama
# ---------------------------------------------------------------------------
# Everything in this section and the two below can also be set from the
# interface: click the gear icon (top right). Values saved there are kept in
# the database and take precedence over this file.
LLM_PROVIDER=openai
OPENAI_CHAT_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# Writing answers with NVIDIA's hosted models (build.nvidia.com)
# ---------------------------------------------------------------------------
# Set LLM_PROVIDER=nvidia above. Keys start with nvapi-.
NVIDIA_API_KEY=
NVIDIA_CHAT_MODEL=meta/llama-3.3-70b-instruct

# ---------------------------------------------------------------------------
# Search
# ---------------------------------------------------------------------------
# The embedding model is fixed in code: openai/text-embedding-3-large.
# Only its width is adjustable. It produces 3072 dimensions, but pgvector's
# index stops at 2000, so it is asked for 1536 - which still scores better than
# text-embedding-3-small at the same width. Changing this reindexes everything.
EMBED_DIM=1536

# ---------------------------------------------------------------------------
# Writing answers with Ollama on your machine instead
# ---------------------------------------------------------------------------
# Set LLM_PROVIDER=ollama above, then:
OLLAMA_CHAT_MODEL=medgemma:4b
# Context window handed to Ollama. Each specialist reads several thousand
# tokens of passages; Ollama's own default is smaller and truncates silently.
OLLAMA_NUM_CTX=16384
#
# Inside a container "localhost" is the container. This name reaches your
# machine on Docker Desktop:
OLLAMA_HOST=http://host.docker.internal:11434
#
# If you get "connection refused": Ollama listens on 127.0.0.1 by default, which
# rejects traffic from Docker. Set a system environment variable on Windows,
#     OLLAMA_HOST=0.0.0.0:11434
# then restart Ollama so it accepts connections from the container.
#
# Or run Ollama as a container instead:
#     docker compose --profile local-llm up -d
# and set OLLAMA_HOST=http://ollama:11434 here.

# ---------------------------------------------------------------------------
# Reading documents
# ---------------------------------------------------------------------------
# fast     ~0.005s per page, keeps about 97% of the text
# thorough ~0.9s per page, keeps headings and reads scanned pages
PDF_EXTRACTION=fast
CHILD_TOKENS=400
PARENT_TOKENS=1600

# ---------------------------------------------------------------------------
# Searching and answering
# ---------------------------------------------------------------------------
# QUERY_VARIANTS  rephrasings searched per specialist (abbreviations expanded,
#                 synonyms, brand/generic drug names)
# EVIDENCE_LIMIT  cited passages shown verbatim to the reviewer and final writer
QUERY_VARIANTS=4
CANDIDATES=30
PASSAGES=8
EVIDENCE_LIMIT=16
# Passages each specialist retrieves before the model narrows them to PASSAGES.
SHORTLIST=24
# Most specialists triage may convene for one question. Lookups use one anyway.
MAX_SPECIALISTS=4
# Write a hypothetical textbook paragraph and search with it as well as the
# question; textbook prose resembles an answer more than a question does.
USE_HYPOTHESIS=true
# Draft, then have a senior reviewer criticise it and search again for what is
# missing. Turning it off roughly halves cost and latency.
ENABLE_REVIEW=true
# Three follow-up questions offered after each answer. Costs one small model
# call per question; set to false to save it.
ENABLE_SUGGESTIONS=true

# ---------------------------------------------------------------------------
# Ports and database
# ---------------------------------------------------------------------------
FRONTEND_PORT=8080
BACKEND_PORT=9000
POSTGRES_PORT=5433
POSTGRES_USER=aidoctor
POSTGRES_PASSWORD=aidoctor
POSTGRES_DB=aidoctor
